# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Stellar Configuration
VITE_STELLAR_NETWORK=TESTNET
VITE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Super Admin Address (Replace with your actual Stellar address)
VITE_SUPER_ADMIN_ADDRESS=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# App Name
VITE_APP_NAME=Relifo

# ===========================================
# WEILCHAIN AUDIT TRAIL CONFIGURATION
# ===========================================

# WeilChain Sentinel URL (the gateway to WeilChain network)
VITE_WEILCHAIN_SENTINEL_URL=https://sentinel.unweil.me

# Your deployed audit trail contract address
# Get this from the deployment output (wadk deploy command)
VITE_WEILCHAIN_AUDIT_CONTRACT=aaaaaasmrquobjshwok2uyfz7gcgg6dbuhvusublvgyrimskqkwws5udqu

# Private key for signing audit trail transactions
# SECURITY WARNING: In production, use a backend service to sign transactions
# instead of exposing this key in the frontend
VITE_WEILCHAIN_SIGNER_KEY=your_weilchain_signer_private_key_here

# ===========================================
# BLOCKCHAIN CONFIGURATION (Polygon)
# ===========================================

# Polygon Amoy Testnet RPC URL
VITE_POLYGON_RPC_URL=https://rpc-amoy.polygon.technology

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
